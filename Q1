#include <iostream>
#include <string>
using namespace std;

class Book {
    int bookID;
    string title, author;
    float price;
public:
    Book() {
        bookID = 0;
        title = "None";
        author = "None";
        price = 0.0;
    }
    Book(int id, string t, string a, float p) {
        bookID = id;
        title = t;
        author = a;
        price = p;
    }
    void displayBookInfo() {
        cout << bookID << " " << title << " " << author << " " << price << endl;
    }
};

